{
  "name": "@dotzen/dotzen",
  "version": "1.9.37",
  "description": "Prose as Code — governance for AI-generated Terraform (AWS, Azure, GCP).",
  "license": "MIT",
  "keywords": [
    "terraform",
    "hcl",
    "governance",
    "policy-as-code",
    "iac",
    "security",
    "cis",
    "compliance",
    "aws",
    "azure",
    "gcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ealmachado-eng/dotzen.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ealmachado-eng/dotzen#readme",
  "bugs": {
    "url": "https://github.com/ealmachado-eng/dotzen/issues"
  },
  "bin": {
    "dotzen": "./bin/dotzen.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.0"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:integration": "vitest run tests",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "gen-docs": "jiti scripts/gen-rule-docs.ts",
    "gen-examples": "jiti scripts/gen-examples.ts",
    "context": "jiti scripts/session-context.ts",
    "check-docs": "jiti scripts/gen-rule-docs.ts && git -C ../.. diff --exit-code --quiet docs/user/reference/rules || (echo '\\nSTALE: docs/user/reference/rules differs from gen-docs output.\\nRun `npm run gen-docs` from packages/cli and commit the result.\\n' && false)",
    "mutation": "stryker run",
    "prepublishOnly": "npm run build",
    "prepack": "cp ../../README.md ./README.md"
  },
  "dependencies": {
    "@cdktf/hcl2json": "^0.21.0",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
