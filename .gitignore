# Dependencies & build output — always regenerate on each machine
# (node_modules is platform-specific; never copy it across machines).
node_modules/
dist/
coverage/
*.tsbuildinfo

# pluvian's CI approval signal (written only when running in CI).
pluvian.env

# Logs & OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp

# Stryker mutation-test report artifacts (regenerated each run).
packages/cli/reports/

# Session state — auto-generated by .githooks/post-commit on every commit.
# Derived from git; never commit. Read by opencode compaction plugin.
.session/

# Keep package-lock.json committed (needed for reproducible `npm ci`).
