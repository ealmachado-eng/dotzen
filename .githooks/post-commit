#!/usr/bin/env bash
# post-commit — refresh .session/state.md after every commit so the next
# session (and the opencode compaction plugin) sees current state.
#
# Versioned via core.hooksPath = .githooks (set once, see AGENTS.md).
# State file is gitignored — derived, never committed.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
state_dir="$repo_root/.session"
state_file="$state_dir/state.md"
mkdir -p "$state_dir"

last_tag=$(git describe --tags --abbrev=0 2>/dev/null || echo "(none)")
head_short=$(git rev-parse --short HEAD)
branch=$(git rev-parse --abbrev-ref HEAD)
last_subject=$(git log -1 --format=%s)
last_body=$(git log -1 --format=%b | head -20 | sed 's/^/    /')
commits_since=$(git rev-list --count "${last_tag}..HEAD" 2>/dev/null || echo "0")

{
  echo "# Session state — auto-generated by .githooks/post-commit"
  echo
  echo "_Do not edit. Derived from git. Refreshed on every commit. Read by the opencode compaction plugin._"
  echo
  echo "- **Branch:** ${branch}"
  echo "- **HEAD:** ${head_short}"
  echo "- **Last tag:** ${last_tag}"
  echo "- **Commits since tag:** ${commits_since}"
  echo
  echo "## Last commit"
  echo
  echo "**${last_subject}**"
  echo
  if [[ -n "${last_body// /}" ]]; then
    echo "${last_body}"
    echo
  fi
  echo "## Recent log (last 10)"
  echo
  echo '```'
  git log --oneline -10
  echo '```'
} > "$state_file"

exit 0
